APP_NAME=ErroNotebook AI Service
APP_VERSION=0.2.0
LOG_LEVEL=INFO

OCR_BACKEND=auto
OCR_ENABLE_PREPROCESS=true
OCR_MOCK_DELAY_SECONDS=0.2
OCR_LOW_CONFIDENCE_THRESHOLD=0.72

LLM_BACKEND=mock
LLM_MOCK_DELAY_SECONDS=0.2

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1200
AI_MAX_ATTEMPTS=3
AI_MAX_REPAIRS=1
AI_ACTION_TIMEOUT_SECONDS=45
AI_HISTORY_MAX_ITEMS=12
AI_CONTEXT_MAX_CHARS=24000

VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=Qwen3-VL-32B-Instruct
VISION_TIMEOUT_SECONDS=30
VISION_TEMPERATURE=0.2
VISION_MAX_TOKENS=600
